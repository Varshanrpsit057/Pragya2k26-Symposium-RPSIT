{
  "name": "pragya-2026",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Website for PRAGYA 2026, the AI & technology symposium at R P Sarathy Institute of Technology, Salem.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "images": "node scripts/optimize-images.mjs",
    "check": "npm run lint && npm run test && npm run build && npm run check:secrets",
    "check:secrets": "node scripts/check-secrets.mjs",
    "google:auth": "node scripts/google-auth.mjs",
    "google:check": "node scripts/google-auth.mjs --check",
    "build:server": "vite build --config vite.server.config.ts --logLevel warn",
    "server": "npm run build:server && node dist-server/node.js",
    "start": "node dist-server/node.js",
    "google:setup": "npm run build:server && node dist-server/setup.js"
  },
  "dependencies": {
    "ogl": "^1.0.11",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true
  },
  "engines": {
    "node": ">=22"
  }
}
