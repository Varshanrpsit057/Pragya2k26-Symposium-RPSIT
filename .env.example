# PRAGYA 2026 settings. Names only: never put real values in this file or in git.
#
# On AWS these are set in the Amplify console for each branch (see README → "Secrets"):
#   Secrets               Amplify console → your app → Hosting → Secrets
#   Plain variables       Amplify console → your app → Hosting → Environment variables
# For the local setup commands (npm run google:auth / google:check / google:setup), copy this
# file to .env, which git ignores.

# --- Amplify SECRETS (required; the API answers "not open yet" until all are set) ----------
# OAuth client from Google Cloud Console (or put its JSON in "google client/" and run google:auth).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Written to .env by npm run google:auth. Set the OAuth consent screen to "In production", or
# Google expires this token after 7 days.
GOOGLE_REFRESH_TOKEN=
# The ID in the sheet's address: docs.google.com/spreadsheets/d/<THIS>/edit
GOOGLE_SHEET_ID=
# The ID in the folder's address: drive.google.com/drive/folders/<THIS>
GOOGLE_DRIVE_PAYMENT_FOLDER_ID=
# The one admin account for /landing/admin. The password is never stored: only its hash,
# made by `npm run admin:password`.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# --- Amplify ENVIRONMENT VARIABLES (optional, not secret) ----------------------------------
# The tab registrations go to (created if missing).
GOOGLE_SHEET_TAB=Registrations
# Where participant passes are saved; empty: a "Participant Passes" folder next to the
# payment folder (npm run google:setup creates it and prints its ID).
GOOGLE_DRIVE_PASS_FOLDER_ID=
# The Gmail account emails are sent from (filled in by google:auth), its display name, a reply-to.
GMAIL_SENDER=
MAIL_FROM_NAME=PRAGYA 2026
MAIL_REPLY_TO=
# Registration attempts allowed per IP address per window. A whole college can share one IP.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MINUTES=10
# Optional cap on simultaneous API runs (e.g. 50), set as an Amplify environment variable at
# build time. Leave empty on a new AWS account, whose concurrency quota may be too low to reserve.
API_RESERVED_CONCURRENCY=
# Extra websites allowed to call the API, comma separated, e.g. a custom domain
# (https://pragya.rpsit.ac.in). The branch's own amplifyapp.com address is always allowed.
ALLOWED_ORIGINS=
# Only to build the site against an API somewhere else; normally read from amplify_outputs.json.
VITE_API_URL=
