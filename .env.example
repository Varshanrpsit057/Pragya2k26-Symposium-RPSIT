# PRAGYA 2026 registration server settings.
# Copy this file to .env and fill it in. Never commit .env: it holds secrets.
#
#   npm run google:auth     signs in once and fills GOOGLE_CLIENT_*, GOOGLE_REFRESH_TOKEN, GMAIL_SENDER
#   npm run google:check    checks the Sheet, the Drive folder and Gmail
#   npm run google:setup    formats the sheet and creates the "Participant Passes" folder

# --- Required: registration stays OFF until all five are set ------------------------------
# OAuth client from Google Cloud Console (or put its JSON in "google client/" and run google:auth).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Written by npm run google:auth. Set the OAuth consent screen to "In production", or Google
# expires this token after 7 days.
GOOGLE_REFRESH_TOKEN=
# The ID in the sheet's address: docs.google.com/spreadsheets/d/<THIS>/edit
GOOGLE_SHEET_ID=
# The ID in the folder's address: drive.google.com/drive/folders/<THIS>
GOOGLE_DRIVE_PAYMENT_FOLDER_ID=

# --- Optional ----------------------------------------------------------------------------
# The tab registrations go to (created if missing).
GOOGLE_SHEET_TAB=Registrations
# Where participant passes are saved; empty: a "Participant Passes" folder next to the payment folder.
GOOGLE_DRIVE_PASS_FOLDER_ID=
# The Gmail account emails are sent from (filled in by google:auth), its display name, and a reply-to.
GMAIL_SENDER=
MAIL_FROM_NAME=PRAGYA 2026
MAIL_REPLY_TO=

# Registrations saved to Google at the same time (1-8). Drive takes about 3 uploads a second.
REGISTRATION_WORKERS=3
# Registration attempts allowed per IP address per window. A whole college can share one IP.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MINUTES=10

# Other websites allowed to call the API, comma separated (the site itself always may).
ALLOWED_ORIGINS=
# Behind a reverse proxy (Nginx, Render, ...): yes, so rate limits use the visitor's real IP.
TRUST_PROXY=
# Port and address to listen on. Defaults: 8787 on 127.0.0.1; with PORT set, every interface.
PORT=
HOST=
