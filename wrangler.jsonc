// OPTIONAL - NOT USED YET. The site currently runs on the Node server (npm run server).
// Kept ready in case PRAGYA 2026 is hosted on Cloudflare Workers later; see server/cloudflare.ts.
// Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pragya-2026",
  "main": "server/cloudflare.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,

  // The built website. Files are served from Cloudflare's edge without running the Worker;
  // only /api/* reaches it.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // The registration desk: one Durable Object for the whole symposium. SQLite-backed, so it
  // runs on the Workers Free plan.
  "durable_objects": {
    "bindings": [{ "name": "DESK", "class_name": "RegistrationDesk" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RegistrationDesk"] }],

  // The RPSIT crest for the participant pass is bundled into the Worker as bytes.
  "rules": [{ "type": "Data", "globs": ["**/*.jpg"], "fallthrough": true }],

  // Settings that are not secret. The Google client, refresh token, Sheet and Drive IDs and
  // sender address are Cloudflare secrets (npm run secrets:push), never stored here.
  "vars": {
    "GOOGLE_SHEET_TAB": "Registrations",
    "MAIL_FROM_NAME": "PRAGYA 2026",
    "REGISTRATION_WORKERS": "3",
    "RATE_LIMIT_MAX": "300",
    "RATE_LIMIT_WINDOW_MINUTES": "10",
    // The Vite dev server and preview, for local testing.
    "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:4173"
  },

  "observability": { "enabled": true }
}
