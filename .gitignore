# Dependencies
node_modules

# Build output
dist
dist-ssr

# Amplify: generated for each environment on every deploy / sandbox run
.amplify
amplify_outputs*
amplifyconfiguration*
*.local

# Logs
*.log
npm-debug.log*

# Environment and secrets (npm run check:secrets also blocks them; see scripts/check-secrets.mjs)
.env
.env.*
!.env.example
/google client/
client_secret_*.json
*.pem
*.key
*.p12
*.pfx
service-account*.json

# Personal photos, reference images and poster originals, kept on your computer only
# (the site uses the WebP copies in src/assets/)
/dev_crew/
/rpsit/
/image/

# Editor / OS / local tooling
.claude/
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
